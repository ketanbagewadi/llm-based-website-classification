# Copy this file to .env and fill in real values, or export these as
# actual environment variables before running the app.

# Flask session secret — change this in production
SECRET_KEY=change-this-to-something-random

# Database location (defaults to instance/site.db if unset)
# DATABASE_URL=sqlite:////absolute/path/to/site.db

# ---- Git push (optional) ----
# Leave GIT_ENABLED unset/false to keep the dashboard fully local.
# Turn it on later once you have a local clone of your domains repo.
GIT_ENABLED=false
GIT_REPO_PATH=/home/ketan/domaindb
